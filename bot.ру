@dp.message(F.text == "💰 Долги")
async def show_debts(message: types.Message):
    debts = await asyncio.to_thread(db_fetchall, "SELECT id, title, amount, due_date, is_paid FROM debts WHERE user_id = ?", (message.from_user.id,))
    if not debts: await message.answer("У тебя пока нет долгов.")
    else:
        for d in debts:
            status = "✅ Оплачен" if d[4] == 1 else f"Срок: {d[3]}"
            text = f"🔹 {d[1]} — {d[2]} руб. | {status}"
            kb_list = []
            if d[4] == 0: kb_list.append([InlineKeyboardButton(text="✅ Оплатить", callback_data=f"pay_debt_{d[0]}")])
            kb_list.append([InlineKeyboardButton(text="🗑 Удалить", callback_data=f"del_debt_{d[0]}")])
            await message.answer(text, reply_markup=InlineKeyboardMarkup(inline_keyboard=kb_list))
    await message.answer("Для добавления используйте Mini App.")

