# ================= ОБРАБОТКА ДАННЫХ ИЗ MINI APP =================
@dp.message(F.web_app_data)
async def handle_webapp_data(message: types.Message):
    try:
        data = json.loads(message.web_app_data.data)
        action = data.get('action')
        if action == 'delete_item':
            item_type = data.get('type'); item_id = data.get('id')
            table_name = "debts" if item_type == "debts" else ("goals" if item_type == "goals" else "savings")
            await asyncio.to_thread(db_execute, f"DELETE FROM {table_name} WHERE id = ? AND user_id = ?", (item_id, message.from_user.id))
            await message.answer("🗑 Запись удалена!")
            return
        title = data.get('title'); amount = data.get('amount'); user_id = message.from_user.id; now = datetime.now().strftime("%Y-%m-%d")
        if action == 'add_debt':
            tomorrow = (datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d')
            await asyncio.to_thread(db_execute, "INSERT INTO debts (user_id, title, kind, amount, due_date) VALUES (?, ?, ?, ?, ?)", (user_id, title, "Мелкие", amount, tomorrow))
            await message.answer(f"✅ Долг «{title}» добавлен!")
    except Exception as e:
        pass

