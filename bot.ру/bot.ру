# --- СБЕРЕЖЕНИЯ ---
@dp.message(F.text == "🏦 Сбережения")
async def show_savings(message: types.Message):
    conn = sqlite3.connect('finance.db')
    cursor = conn.cursor()
    cursor.execute("SELECT amount, source, date FROM savings WHERE user_id = ?", (message.from_user.id,))
    savings = cursor.fetchall()
    conn.close()
    
    total = sum([s[0] for s in savings])
    text = f"Всего накоплений: {total} руб.\n\n"
    
    if not savings:
        text += "Пока нет записей. Напиши 'Добавить сбережение'."
    else:
        text += "Последние записи:\n"
        for s in savings[-5:]:
            text += f"💰 {s[0]} руб. ({s[1]}) — {s[2]}\n"
        text += "\nНапиши 'Добавить сбережение', чтобы добавить."
    await message.answer(text)

@dp.message(F.text.lower() == "добавить сбережение")
async def add_saving_start(message: types.Message, state: FSMContext):
    await message.answer("Введи сумму:", reply_markup=back_menu())
    await state.set_state(SavingForm.amount)

@dp.message(SavingForm.amount)
async def add_saving_amount(message: types.Message, state: FSMContext):
    if message.text == "Отмена":
        await state.clear()
        return await message.answer("Отменено.", reply_markup=main_menu())
    try:
        amount = float(message.text.replace(',', '.'))
    except:
        return await message.answer("Ошибка. Введи число.")
    await state.update_data(amount=amount)
    await message.answer("Введи источник (например, 'Зарплата'):", reply_markup=back_menu())
    await state.set_state(SavingForm.source)

@dp.message(SavingForm.source)
async def add_saving_source(message: types.Message, state: FSMContext):
    if message.text == "Отмена":
        await state.clear()
        return await message.answer("Отменено.", reply_markup=main_menu())
    data = await state.get_data()
    now = datetime.now().strftime("%Y-%m-%d")
    conn = sqlite3.connect('finance.db')
    cursor = conn.cursor()
    cursor.execute("INSERT INTO savings (user_id, amount, source, date) VALUES (?, ?, ?, ?)",
                   (message.from_user.id, data['amount'], message.text, now))
    conn.commit()
    conn.close()
    await state.clear()
    await message.answer("Сбережение добавлено!", reply_markup=main_menu())

# --- ЗАПУСК ---
async def main():
    print("Бот запущен...")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
