# --- Долги ---
@dp.callback_query(F.data == "add_debt_btn")
async def add_debt_start(callback: types.CallbackQuery, state: FSMContext):
    await state.set_state(DebtForm.title)
    await callback.message.answer("Введи название долга (например, 'Другу Васе'):", reply_markup=back_menu())
    await callback.answer()

@dp.callback_query(F.data.startswith("pay_debt_"))
async def pay_debt(callback: types.CallbackQuery):
    debt_id = int(callback.data.split("_")[2])
    conn = sqlite3.connect('finance.db')
    cursor = conn.cursor()
    cursor.execute("UPDATE debts SET is_paid = 1 WHERE id = ? AND user_id = ?", (debt_id, callback.from_user.id))
    conn.commit()
    conn.close()
    await callback.message.edit_text(f"{callback.message.text}\n\n✅ *Долг закрыт!*", parse_mode="Markdown", reply_markup=None)
    await callback.answer("Долг погашен.")

@dp.callback_query(F.data.startswith("del_debt_"))
async def delete_debt(callback: types.CallbackQuery):
    debt_id = int(callback.data.split("_")[2])
    conn = sqlite3.connect('finance.db')
    cursor = conn.cursor()
    cursor.execute("DELETE FROM debts WHERE id = ? AND user_id = ?", (debt_id, callback.from_user.id))
    conn.commit()
    conn.close()
    await callback.message.delete()
    await callback.answer("Долг удален!")

