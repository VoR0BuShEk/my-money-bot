@dp.message(F.text == "🏦 Сбережения")
async def show_savings(message: types.Message):
    conn = sqlite3.connect('finance.db')
    cursor = conn.cursor()
    cursor.execute("SELECT id, amount, source, date FROM savings WHERE user_id = ?", (message.from_user.id,))
    savings = cursor.fetchall()
    conn.close()
    
    if not savings:
        await message.answer("Пока нет записей. Напиши 'Добавить сбережение'.")
    else:
        total = sum(s[1] for s in savings)
        await message.answer(f"Всего накоплений: {total} руб.\n")
        
        for s in savings[-10:]:
            text = f"💰 {s[1]} руб. ({s[2]}) — {s[3]}"
            kb = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="🗑 Удалить", callback_data=f"del_sav_{s[0]}")]
            ])
            await message.answer(text, reply_markup=kb)
        await message.answer("Напиши 'Добавить сбережение', чтобы добавить.", reply_markup=main_menu())

