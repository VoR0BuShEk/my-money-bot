import asyncio
import os
import sqlite3
from datetime import datetime, timedelta
from aiogram import Bot, Dispatcher, F, types
from aiogram.filters import Command
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.types import InlineKeyboardButton, InlineKeyboardMarkup, ReplyKeyboardMarkup, KeyboardButton
from aiogram.fsm.storage.memory import MemoryStorage
from apscheduler.schedulers.asyncio import AsyncIOScheduler

# --- БАЗА ДАННЫХ ---
def init_db():
    conn = sqlite3.connect('finance.db')
    cursor = conn.cursor()
    cursor.execute('''CREATE TABLE IF NOT EXISTS debts (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER, title TEXT, kind TEXT, amount REAL, due_date TEXT)''')
    cursor.execute('''CREATE TABLE IF NOT EXISTS goals (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER, title TEXT, price REAL, due_date TEXT)''')
    cursor.execute('''CREATE TABLE IF NOT EXISTS savings (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER, amount REAL, source TEXT, date TEXT)''')
    
    try:
        cursor.execute("ALTER TABLE debts ADD COLUMN is_paid INTEGER DEFAULT 0")
    except sqlite3.OperationalError:
        pass 
    
    try:
        cursor.execute("ALTER TABLE goals ADD COLUMN saved REAL DEFAULT 0")
    except sqlite3.OperationalError:
        pass 

    conn.commit()
    conn.close()

init_db()

# --- СОСТОЯНИЯ (FSM) ---
class DebtForm(StatesGroup):
    title = State()
    kind = State()
    amount = State()
    date = State()

class GoalForm(StatesGroup):
    title = State()
    price = State()
    date = State()

class SavingForm(StatesGroup):
    amount = State()
    source = State()

class DepositForm(StatesGroup):
    amount = State()

# --- КЛАВИАТУРЫ ---
def main_menu():
    kb = [
        [KeyboardButton(text="💰 Долги"), KeyboardButton(text="🎯 Цели")],
        [KeyboardButton(text="🏦 Сбережения"), KeyboardButton(text="📊 Статистика")]
    ]
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True)

def kind_menu():
    kb = [[KeyboardButton(text="Мелкие")], [KeyboardButton(text="Кредиты")]]
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True, one_time_keyboard=True)

def back_menu():
    return ReplyKeyboardMarkup(keyboard=[[KeyboardButton(text="Отмена")]], resize_keyboard=True, one_time_keyboard=True)

# --- ОСНОВНОЙ КОД ---
bot = Bot(token=os.getenv("BOT_TOKEN"))
dp = Dispatcher(storage=MemoryStorage())

# --- ФОНОВАЯ ЗАДАЧА ---
async def check_reminders():
    tomorrow = (datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d')
    conn = sqlite3.connect('finance.db')
    cursor = conn.cursor()
    cursor.execute("SELECT user_id, title, amount, due_date FROM debts WHERE due_date = ? AND is_paid = 0", (tomorrow,))
    debts = cursor.fetchall()
    cursor.execute("SELECT user_id, title, price, saved, due_date FROM goals WHERE due_date = ?", (tomorrow,))
    goals = cursor.fetchall()
    conn.close()

    for d in debts:
        try:
            await bot.send_message(d[0], f"🔔 *Напоминание!* Завтра ({d[3]}) срок оплаты долга:\n🔹 {d[1]} — {d[2]} руб.", parse_mode="Markdown")
        except Exception:
            pass

    for g in goals:
        try:
            await bot.send_message(g[0], f"🔔 *Напоминание!* Завтра ({g[4]}) дедлайн по цели:\n🎯 {g[1]} (Накоплено {g[3]} из {g[2]} руб.)", parse_mode="Markdown")
        except Exception:
            pass

async def main():
    scheduler = AsyncIOScheduler()
    scheduler.add_job(check_reminders, 'cron', hour=10, minute=0)
    scheduler.start()
    print("Бот запущен...")
    await dp.start_polling(bot)

# ================= СТАРТ =================
@dp.message(Command("start"))
async def start(message: types.Message, state: FSMContext):
    await state.clear() # Сбрасываем старые состояния
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🚀 Начать", callback_data="go_main_menu")]
    ])
    await message.answer("Привет! Я твой умный финансовый трекер.", reply_markup=kb)

@dp.callback_query(F.data == "go_main_menu")
async def go_to_main_menu(callback: types.CallbackQuery, state: FSMContext):
    await state.clear()
    await callback.message.delete()
    await callback.message.answer("Выбери раздел:", reply_markup=main_menu())
    await callback.answer()

